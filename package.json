{
  "name": "git-data-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "npm run dev -w @git-data-explorer/main",
    "research": "npm run dev -w @git-data-explorer/research",
    "test": "vitest run --reporter=verbose",
    "seed": "npm run seed -w @git-data-explorer/main",
    "dev:seed": "DB_PATH=./data/seed.db npm run dev -w @git-data-explorer/main",
    "db:generate": "npm run db:generate -w @git-data-explorer/main",
    "db:migrate": "npm run db:migrate -w @git-data-explorer/main"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/geist": "^5.2.8",
